{
  "name": "slimgym",
  "version": "1.5.5",
  "description": "An indentation-based configuration format parser for the 24th and ½ century!",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "import": "./dist/parse.js",
      "require": "./dist/parse.js"
    },
    "./slimgify": {
      "types": "./dist/slimgify.d.ts",
      "import": "./dist/slimgify.js",
      "require": "./dist/slimgify.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run tsc",
    "lint": "bun run eslint .",
    "lint:fix": "bun run eslint . --fix",
    "prepublishOnly": "bun run build",
    "publish:unversioned": "bun run build && npm publish --no-git-checks",
    "publish:patch": "npm version patch && npm publish --no-git-checks",
    "publish:minor": "npm version minor && npm publish --no-git-checks",
    "publish:major": "npm version major && npm publish --no-git-checks",
    "test": "bun run vitest run",
    "test:ui": "bun run vitest --ui",
    "test:watch": "bun run vitest",
    "test:coverage": "bun run vitest --coverage",
    "test:stress": "bun run vitest run slimgym.stress.test.ts"
  },
  "keywords": [
    "config",
    "parser",
    "configuration",
    "yaml",
    "json",
    "indentation",
    "slimgym"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eliranbenishai/slimgym.git"
  },
  "bugs": {
    "url": "https://github.com/eliranbenishai/slimgym/issues"
  },
  "homepage": "https://slimgym.dev",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bun": "latest",
    "@vitest/ui": "^4.0.0",
    "eslint": "^9.0.0",
    "jiti": "^2.6.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
