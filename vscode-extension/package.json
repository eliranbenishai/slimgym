{
    "name": "slimgym",
    "displayName": "SlimGym",
    "description": "Syntax highlighting for SlimGym configuration format (.sg files)",
    "version": "0.1.0",
    "publisher": "eliranbenishai",
    "repository": {
        "type": "git",
        "url": "https://github.com/eliranbenishai/slimgym"
    },
    "license": "MIT",
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "slimgym",
        "sg",
        "config",
        "configuration",
        "syntax highlighting"
    ],
    "contributes": {
        "languages": [
            {
                "id": "slimgym",
                "aliases": [
                    "Slimgym",
                    "slimgym"
                ],
                "extensions": [
                    ".sg"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "slimgym",
                "scopeName": "source.slimgym",
                "path": "./syntaxes/slimgym.tmLanguage.json"
            }
        ]
    }
}